# Local simulator only. Replace both values before exposing the service.
TRICKEE_DEMO_MODE=1
TRICKEE_OPERATOR_KEY=local-demo-operator-key
TRICKEE_VEHICLE_KEY=local-demo-vehicle-key
TRICKEE_DB=data/cloud.db
# Optional public HTTPS identity-provider account pages, never secret-bearing URLs.
# Password resets, verification email, registration and password changes remain
# managed and audited by that identity provider. Driver keys are replaced by admins.
# TRICKEE_ACCOUNT_LOGIN_URL=https://identity.example/account/login
# TRICKEE_ACCOUNT_REGISTRATION_URL=https://identity.example/account/register
# TRICKEE_ACCOUNT_RECOVERY_URL=https://identity.example/account/recover
# TRICKEE_ACCOUNT_SECURITY_URL=https://identity.example/account/security
# Set an approved positive completed-trip retention period and schedule the sweep command.
# TRICKEE_PHONE_GPS_RETENTION_DAYS=30
# Optional contracted HTTPS charger feed; never put a real token in this example.
# TRICKEE_CHARGER_FEED_URL=https://charger-provider.example/v1
# TRICKEE_CHARGER_FEED_TOKEN=<secret from your secret manager>
# Optional OCPI 2.3.0 CPO Sender endpoints. Run `python -m trickee.ocpi_sync`
# with the same TRICKEE_DB as the API to reconcile sessions and CDRs.
# TRICKEE_OCPI_LOCATIONS_URL=https://cpo.example/ocpi/2.3.0/locations
# TRICKEE_OCPI_SESSIONS_URL=https://cpo.example/ocpi/2.3.0/sessions
# TRICKEE_OCPI_CDRS_URL=https://cpo.example/ocpi/2.3.0/cdrs
# TRICKEE_OCPI_TOKEN=<secret from your secret manager>
# TRICKEE_OCPI_TENANT_ID=<operator tenant that owns this provider account>
# Optional server-side route context. Neither key is sent to a browser.
# TRICKEE_OPENWEATHER_API_KEY=<secret from your secret manager>
# TRICKEE_ELEVATION_URL=https://licensed-elevation-provider.example/v1
# TRICKEE_ELEVATION_TOKEN=<secret from your secret manager>
# TRICKEE_ELEVATION_CACHE_SECONDS=0
# TRICKEE_CONTEXT_DAILY_LIMIT=100
# In-app reminder generation runs independently of browser refresh (1..3600 seconds).
# TRICKEE_WORKSPACE_REMINDER_SECONDS=30
# Optional versioned partner order feed. Imported records remain read-only and
# require an operator review before any internal driver assignment.
# TRICKEE_ORDER_FEED_URL=https://orders-provider.example/v1/orders
# TRICKEE_ORDER_FEED_TOKEN_FILE=/run/secrets/order_feed_token
# TRICKEE_ORDER_FEED_SOURCE=provider_name
# TRICKEE_ORDER_FEED_TENANT_ID=operator_tenant
